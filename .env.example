# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted (used for OAuth callbacks and API endpoints).
APP_URL=
SITE_URL=

# GitHub OAuth App (Read-only repository explorer)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional explicit callback override (e.g. https://citrine-management.vercel.app/api/github/callback)
GITHUB_CALLBACK_URL=

# Supabase configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Database / Cloud SQL
DATABASE_URL=
SQL_HOST=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Email / SMTP & HR Notifications
HR_NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SENDER_NAME=

# Pusher Beams (Web Push)
PUSHER_BEAMS_INSTANCE_ID=
PUSHER_BEAMS_SECRET_KEY=
VITE_PUSHER_BEAMS_INSTANCE_ID=
