# Citrine Management - production OVH
NODE_ENV=production
PORT=3000
APP_URL=https://management.citrine-mobilite.com
SITE_URL=https://management.citrine-mobilite.com

# MariaDB OVH (secrets uniquement côté serveur)
SQL_HOST=localhost
SQL_PORT=3306
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
SQL_CONNECTION_LIMIT=5

# Notifications push Pusher Beams
PUSHER_BEAMS_INSTANCE_ID=
PUSHER_BEAMS_SECRET_KEY=
VITE_PUSHER_BEAMS_INSTANCE_ID=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SENDER_NAME=Citrine Mobilité RH
HR_NOTIFICATION_EMAIL=

# Resend (facultatif)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CRON_SECRET=
