{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.ico|favicon-.*\\.png|apple-touch-icon\\.png|icon\\.svg|manifest\\.json|sw\\.js|pwa-.*\\.png|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
