{
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "includeFiles": "src/**/*.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.ico|manifest\\.webmanifest|icon-.*\\.png|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
