{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.ico|manifest\\.webmanifest|icon-.*\\.png|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/monday-greeting",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/daily-timesheet",
      "schedule": "30 18 * * 1-5"
    },
    {
      "path": "/api/cron/weekly-recap",
      "schedule": "0 19 * * 5"
    }
  ]
}
